APP_NAME=YouCast
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Public origin used in e-mails and absolute links. Password-reset links are
# built from this value, never from an untrusted request Host header.
APP_URL=http://localhost:8000

# Production checklist: APP_ENV=production, APP_DEBUG=false, a real APP_KEY
# generated with `php artisan key:generate`, LOG_LEVEL=info, and
# SESSION_SECURE_COOKIE=true (the session cookie must only travel over HTTPS).
# Behind a reverse proxy, configure TrustProxies so that client IP addresses
# are correct for rate limiting.

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# SQLite tuning. `busy_timeout` makes concurrent writers wait instead of
# failing immediately; WAL lets readers continue during a write.
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# "null" auto-enables the secure flag when the request already uses HTTPS.
# Set it to true in production so the cookie never travels over plain HTTP.
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Local development default: the log transport writes emails (including the
# password-reset link) to storage/logs/laravel.log. Never use it in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Recommended local inbox: run Mailpit, then uncomment this block. The reset
# email is visible at http://localhost:8025 and no real email is sent.
# MAIL_MAILER=smtp
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# MAIL_SCHEME=null
# MAIL_USERNAME=null
# MAIL_PASSWORD=null

# Production example (replace every placeholder; never commit credentials).
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SCHEME=null
# MAIL_USERNAME=your-smtp-username
# MAIL_PASSWORD=your-smtp-password
# MAIL_FROM_ADDRESS="no-reply@youcast.example"
# MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
